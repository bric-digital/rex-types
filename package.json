    "description": "REX module defining conversational data types for recording inter-personal or inter-machine exchanges.",
    "keywords": [
        "extension",
        "rex"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "main": "index.mts",
    "homepage": "https://github.com/bric-digital/rex-types",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-types/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-types.git"
    },
    "exports": {
        "./types": "./src/types.mts"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
